@model Result<List<AdminUserRequestOutput>>

<h3>Yetkili Kullanıcılar</h3>

@if (Model.Error is not null)
{
    <div class="alert alert-info" role="alert">@Model.Error.Code</div>
}

@if (Model.IsSuccess)
{
    <div class="d-flex">
        @foreach (var admin in Model.Value)
        {
            <div class="admin-card">
                <div class="profile-photo">
                    <img src="~/img/avatar.jpg" alt="@admin.DisplayName" />
                </div>
                <div>
                    <span>@admin.DisplayName</span>
                </div>
            </div>
        }
    </div>

    @section styles {
    <style>
        .d-flex {
            gap: 20px;
        }

        /* Kart */
        .admin-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: #ffffff;
            border-radius: 10px;
            border: 1px solid #e6e6e6;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            transition: all 0.2s ease;
            cursor: pointer;
            min-width: 180px;
        }

            /* Hover efekti */
            .admin-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 14px rgba(0,0,0,0.1);
            }

        /* Profil foto */
        .profile-photo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;
        }

            .profile-photo img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        /* İsim */
        .admin-card span {
            font-weight: 500;
            color: #333;
            font-size: 15px;
        }
    </style>
    }
}

